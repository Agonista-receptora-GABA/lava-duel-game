{
  "name": "lava-duel-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:fe": "vite",
    "dev:fe1": "VITE_SOCKET_URL=http://localhost:3000 vite --port 5173",
    "dev:fe2": "VITE_SOCKET_URL=http://localhost:3001 vite --port 5174",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "dev:server1": "PORT=3000 REDIS_URL=redis://127.0.0.1:6379 npm run dev:server",
    "dev:server2": "PORT=3001 REDIS_URL=redis://127.0.0.1:6379 npm run dev:server",
    "build:fe": "run-p type-check \"build-only {@}\" --",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "run-s build:fe build:server",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "test:unit": "vitest --project unit",
    "test:server": "vitest --project server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build tsconfig.app.json",
    "type-check:tests": "tsc --project tsconfig.tests.json",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "pinia": "^3.0.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/express": "^5.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
